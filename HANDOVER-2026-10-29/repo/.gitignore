# Chartink pipeline: rendered pages and the run log are regenerated nightly.
data/chartink/**/*.html
data/chartink/_collector.log

# Shallow-analysis corpus: raw PDFs stay on the operator's disk; the page-marked
# text extractions, cards, manifests and framework are tracked and readable.
screens/corpus/**/*.pdf

# Step-1 corpus repair: page images rendered from scanned filings are derived
# artifacts (regenerated by the pymupdf render step recorded in manifest notes).
# The page-marked .txt extractions and the source PDFs are tracked.
runs/*/extracted/images/
