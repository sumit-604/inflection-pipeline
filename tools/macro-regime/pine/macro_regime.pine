// @version=6
// Macro Regime Dials, 6 to 12 month horizon.
// Pine port of tools/macro-regime/model.py (inflection-pipeline, PR #205).
// Same inputs, transforms and thresholds where TradingView carries the series.
//
// Use on a MONTHLY chart of any symbol. All inputs are pulled at 1M.
// Outputs: five dials (z), the regime quadrant as background colour, liquidity
// and stress tags, and an optional band score per asset (-1, 0, +1) that you
// can feed to a strategy through input.source for your own backtest.
//
// Differences from the Python, stated:
//  - z-score window needs 60 monthly bars (the Python allows 36). Dials start
//    5 years after the youngest input in them.
//  - FPI flows (NSDL) and CFTC positioning are not TradingView series; the
//    India dial runs without the FPI input.
//  - Copper/gold uses front-month futures, not Pink Sheet averages.
//  - Bands failed PASS_BAR.md (a) and are OFF by default. Turn them on to test.
//
// Regime key: R REFLATION (green) growth up, inflation up; G GOLDILOCKS (teal)
// growth up, inflation down; S STAGFLATION (red) growth down, inflation up;
// D DEFLATION (grey) both down. Letter strip at the pane bottom, a label at
// each change, legend top-left. Alerts: regime change, stress HIGH,
// liquidity TIGHT / EASING.

indicator("Macro Regime Dials (6-12m)", shorttitle = "MacroRegime", overlay = false, max_bars_back = 500, max_labels_count = 500)

// ---------------------------------------------------------------- inputs
zWin      = input.int(60, "z-score window, months", minval = 24)
smooth    = input.int(3, "dial smoothing, months", minval = 1)
dirLen    = input.int(6, "direction lookback, months", minval = 1)
liqHi     = input.float(0.25, "LIQUIDITY easing above")
liqLo     = input.float(-0.25, "LIQUIDITY tight below")
stHi      = input.float(1.0, "STRESS high above")
stLo      = input.float(-0.5, "STRESS low below")
showBands = input.bool(false, "Show exposure bands (failed bar; test only)")
bandAsset = input.string("nifty", "Band to plot", options = ["gold", "silver", "aluminium", "zinc", "brent", "nifty"])
showStrip = input.bool(true, "Regime letter strip (R G S D)")
showLabels = input.bool(true, "Label each regime change")
showLegend = input.bool(true, "Legend table")
stripY     = input.float(-2.7, "Letter strip y level")

// ---------------------------------------------------------------- series
m(sym) => request.security(sym, "1M", close, ignore_invalid_symbol = true)

// prices
copper  = m("COMEX:HG1!")
gold    = m("COMEX:GC1!")
sse     = m("SSE:000001")
dxy     = m("TVC:DXY")
usdinr  = m("FX_IDC:USDINR")
vix     = m("CBOE:VIX")
invix   = m("NSE:INDIAVIX")
// FRED
dfii10  = m("FRED:DFII10")
t10yie  = m("FRED:T10YIE")
t10y2y  = m("FRED:T10Y2Y")
fedfund = m("FRED:FEDFUNDS")
cpi     = m("FRED:CPIAUCSL")
corecpi = m("FRED:CPILFESL")
m2      = m("FRED:M2SL")
walcl   = m("FRED:WALCL")
nfci    = m("FRED:NFCI")
baa10y  = m("FRED:BAA10Y")
stlfsi  = m("FRED:STLFSI4")
indpro  = m("FRED:INDPRO")
recpro  = m("FRED:RECPROUSM156N")
epuUS   = m("FRED:USEPUINDXM")
epuGl   = m("FRED:GEPUCURRENT")
epuIN   = m("FRED:INDEPUINDXM")
inCall  = m("FRED:IRSTCI01INM156N")
inCpi   = m("FRED:CPALTT01INM659N")

// ------------------------------------------------------------ transforms
chg(float s, int n)    => s - s[n]
logchg(float s, int n) => math.log(s) - math.log(s[n])
yoy(float s)           => 100 * (s / s[12] - 1)
zs(float s) =>
    mu = ta.sma(s, zWin)
    sd = ta.stdev(s, zWin)
    z  = sd > 0 ? (s - mu) / sd : na
    math.max(-3, math.min(3, z))

// mean of up to 6 values, skipping na (the Python's skipna mean)
mean6(float a, float b, float c, float d, float e, float f) =>
    sum = 0.0
    n = 0
    if not na(a)
        sum += a
        n += 1
    if not na(b)
        sum += b
        n += 1
    if not na(c)
        sum += c
        n += 1
    if not na(d)
        sum += d
        n += 1
    if not na(e)
        sum += e
        n += 1
    if not na(f)
        sum += f
        n += 1
    n > 0 ? sum / n : na

// ----------------------------------------------------------------- dials
cuau = copper / gold
GROWTH = mean6(zs(logchg(cuau, 6)), zs(logchg(copper, 6)), zs(yoy(indpro)), -zs(recpro), zs(t10y2y), zs(logchg(sse, 6)))
INFLATION = mean6(zs(t10yie), zs(chg(t10yie, 6)), zs(yoy(cpi)), zs(chg(yoy(corecpi), 6)), float(na), float(na))
LIQUIDITY = mean6(zs(yoy(m2)), zs(logchg(walcl, 6)), -zs(chg(fedfund, 6)), -zs(nfci), -zs(chg(math.log(dxy), 6)), -zs(chg(dfii10, 6)))
STRESS = mean6(zs(vix), zs(baa10y), zs(stlfsi), zs(epuUS), zs(epuGl), float(na))
IN_STRESS = mean6(zs(invix), zs(epuIN), zs(logchg(usdinr, 6)), zs(chg(inCall, 6)), zs(inCpi), float(na))   // FPI input not on TradingView

gS = ta.sma(GROWTH, smooth)
iS = ta.sma(INFLATION, smooth)
lS = ta.sma(LIQUIDITY, smooth)
sS = ta.sma(STRESS, smooth)
nS = ta.sma(IN_STRESS, smooth)

// ---------------------------------------------------------------- regime
gUp = gS - gS[dirLen] > 0
iUp = iS - iS[dirLen] > 0
// 0 REFLATION, 1 GOLDILOCKS, 2 STAGFLATION, 3 DEFLATION
quad = na(gS - gS[dirLen]) or na(iS - iS[dirLen]) ? int(na) : gUp and iUp ? 0 : gUp and not iUp ? 1 : not gUp and iUp ? 2 : 3
quadName = quad == 0 ? "REFLATION" : quad == 1 ? "GOLDILOCKS" : quad == 2 ? "STAGFLATION" : quad == 3 ? "DEFLATION" : "n/a"
liqTag = lS > liqHi ? "EASING" : lS < liqLo ? "TIGHT" : "NEUTRAL"
stTag  = sS > stHi ? "HIGH" : sS < stLo ? "LOW" : "NORMAL"
inTag  = nS > stHi ? "HIGH" : nS < stLo ? "LOW" : "NORMAL"

// ----------------------------------------------------------------- bands
// Base band by quadrant [REFL, GOLD, STAG, DEFL]; same table as model.py.
base(string asset, int q) =>
    r = 0
    if asset == "gold"
        r := q == 0 ? 0 : q == 1 ? -1 : q == 2 ? 1 : 0
    if asset == "silver"
        r := q == 0 ? 1 : q == 1 ? 0 : q == 2 ? 0 : -1
    if asset == "aluminium" or asset == "zinc"
        r := q == 0 ? 1 : q == 1 ? 1 : q == 2 ? -1 : -1
    if asset == "brent"
        r := q == 0 ? 1 : q == 1 ? -1 : q == 2 ? 1 : -1
    if asset == "nifty"
        r := q == 0 ? 0 : q == 1 ? 1 : q == 2 ? -1 : 0
    r
band(string asset) =>
    s = base(asset, quad)
    liqShade = asset == "brent" ? 0 : 1
    s += liqTag == "EASING" ? liqShade : liqTag == "TIGHT" ? -liqShade : 0
    s += stTag == "HIGH" ? (asset == "gold" ? 1 : -1) : 0
    s += asset == "nifty" and inTag == "HIGH" ? -1 : 0
    na(quad) ? int(na) : math.max(-1, math.min(1, s))
bandSel = band(bandAsset)

// --------------------------------------------------------------- colours
cREFL = color.green
cGOLD = color.teal
cSTAG = color.red
cDEFL = color.gray
quadColor(int q) => q == 0 ? cREFL : q == 1 ? cGOLD : q == 2 ? cSTAG : q == 3 ? cDEFL : color.new(color.white, 100)
quadLetter(int q) => q == 0 ? "R" : q == 1 ? "G" : q == 2 ? "S" : q == 3 ? "D" : ""
quadFull(int q) => q == 0 ? "REFLATION" : q == 1 ? "GOLDILOCKS" : q == 2 ? "STAGFLATION" : q == 3 ? "DEFLATION" : "n/a"

// ----------------------------------------------------------------- plots
plot(gS, "GROWTH", color = color.new(color.green, 0), linewidth = 2)
plot(iS, "INFLATION", color = color.new(color.red, 0), linewidth = 2)
plot(lS, "LIQUIDITY", color = color.new(color.blue, 0), linewidth = 2)
plot(sS, "STRESS", color = color.new(color.orange, 0), linewidth = 2)
plot(nS, "IN_STRESS", color = color.new(color.purple, 0), linewidth = 1)
hline(0)
hline(stHi, "stress high", color = color.new(color.orange, 60), linestyle = hline.style_dotted)
hline(liqHi, "easing", color = color.new(color.blue, 60), linestyle = hline.style_dotted)
hline(liqLo, "tight", color = color.new(color.blue, 60), linestyle = hline.style_dotted)
bgcolor(na(quad) ? na : color.new(quadColor(quad), 88), title = "regime")

// letter strip: one letter per month at a fixed level, in the regime colour
plotchar(showStrip and quad == 0 ? stripY : na, "R reflation", char = "R", location = location.absolute, color = cREFL, size = size.tiny)
plotchar(showStrip and quad == 1 ? stripY : na, "G goldilocks", char = "G", location = location.absolute, color = cGOLD, size = size.tiny)
plotchar(showStrip and quad == 2 ? stripY : na, "S stagflation", char = "S", location = location.absolute, color = cSTAG, size = size.tiny)
plotchar(showStrip and quad == 3 ? stripY : na, "D deflation", char = "D", location = location.absolute, color = cDEFL, size = size.tiny)

// label at each regime change: new regime name, and how long the old one ran
var int regimeStart = na
regimeChanged = not na(quad) and quad != quad[1] and not na(quad[1])
if regimeChanged
    monthsRan = na(regimeStart) ? 0 : bar_index - regimeStart
    if showLabels
        label.new(bar_index, stripY + 0.35, quadFull(quad) + (monthsRan > 0 ? "\n(" + quadFull(quad[1]) + " ran " + str.tostring(monthsRan) + "m)" : ""), style = label.style_label_up, color = color.new(quadColor(quad), 20), textcolor = color.white, size = size.small)
    regimeStart := bar_index
if na(regimeStart) and not na(quad)
    regimeStart := bar_index

// alerts
alertcondition(regimeChanged, "Regime changed", "Macro regime changed")
alertcondition(sS > stHi and sS[1] <= stHi, "Stress crossed HIGH", "Global STRESS dial crossed HIGH")
alertcondition(lS < liqLo and lS[1] >= liqLo, "Liquidity turned TIGHT", "LIQUIDITY dial turned TIGHT")
alertcondition(lS > liqHi and lS[1] <= liqHi, "Liquidity turned EASING", "LIQUIDITY dial turned EASING")
plot(showBands ? bandSel : na, "Band score (selected asset)", color = color.new(color.black, 0), style = plot.style_stepline, linewidth = 2, display = display.all)
// Exported for strategies via input.source (always computed, hidden unless showBands):
plot(band("gold"), "band gold", display = display.none)
plot(band("silver"), "band silver", display = display.none)
plot(band("aluminium"), "band aluminium", display = display.none)
plot(band("zinc"), "band zinc", display = display.none)
plot(band("brent"), "band brent", display = display.none)
plot(band("nifty"), "band nifty", display = display.none)
plot(quad, "quadrant 0-3", display = display.none)

// ---------------------------------------------------------------- legend
// Nifty and gold 12-month medians by quadrant are from EVALUATION_2026-10.md
// section 4 (2004-01 to 2025-09, 272 months). Reference only, not a forecast.
var lg = table.new(position.top_left, 5, 5, border_width = 1)
if barstate.islast and showLegend
    table.cell(lg, 0, 0, "", bgcolor = color.new(color.gray, 70))
    table.cell(lg, 1, 0, "Regime", bgcolor = color.new(color.gray, 70))
    table.cell(lg, 2, 0, "Growth / Inflation", bgcolor = color.new(color.gray, 70))
    table.cell(lg, 3, 0, "Nifty 12m med", bgcolor = color.new(color.gray, 70))
    table.cell(lg, 4, 0, "Gold 12m med", bgcolor = color.new(color.gray, 70))
    table.cell(lg, 0, 1, "R", bgcolor = color.new(cREFL, 30), text_color = color.white)
    table.cell(lg, 1, 1, "REFLATION")
    table.cell(lg, 2, 1, "up / up")
    table.cell(lg, 3, 1, "+15.4%")
    table.cell(lg, 4, 1, "+8.7%")
    table.cell(lg, 0, 2, "G", bgcolor = color.new(cGOLD, 30), text_color = color.white)
    table.cell(lg, 1, 2, "GOLDILOCKS")
    table.cell(lg, 2, 2, "up / down")
    table.cell(lg, 3, 2, "+12.3%")
    table.cell(lg, 4, 2, "+10.1%")
    table.cell(lg, 0, 3, "S", bgcolor = color.new(cSTAG, 30), text_color = color.white)
    table.cell(lg, 1, 3, "STAGFLATION")
    table.cell(lg, 2, 3, "down / up")
    table.cell(lg, 3, 3, "+7.6%")
    table.cell(lg, 4, 3, "+5.8%")
    table.cell(lg, 0, 4, "D", bgcolor = color.new(cDEFL, 30), text_color = color.white)
    table.cell(lg, 1, 4, "DEFLATION")
    table.cell(lg, 2, 4, "down / down")
    table.cell(lg, 3, 4, "+12.7%")
    table.cell(lg, 4, 4, "+18.2%")

// ----------------------------------------------------------------- table
var t = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "Regime", bgcolor = color.new(color.gray, 70))
    table.cell(t, 1, 0, quadLetter(quad) + "  " + quadName, bgcolor = color.new(quadColor(quad), 30), text_color = color.white)
    table.cell(t, 0, 1, "GROWTH")
    table.cell(t, 1, 1, str.tostring(gS, "#.00"))
    table.cell(t, 0, 2, "INFLATION")
    table.cell(t, 1, 2, str.tostring(iS, "#.00"))
    table.cell(t, 0, 3, "LIQUIDITY")
    table.cell(t, 1, 3, str.tostring(lS, "#.00") + "  " + liqTag)
    table.cell(t, 0, 4, "STRESS")
    table.cell(t, 1, 4, str.tostring(sS, "#.00") + "  " + stTag)
    table.cell(t, 0, 5, "IN_STRESS")
    table.cell(t, 1, 5, str.tostring(nS, "#.00") + "  " + inTag)
    table.cell(t, 0, 6, "Band " + bandAsset)
    table.cell(t, 1, 6, showBands ? str.tostring(bandSel, "#") : "off")
